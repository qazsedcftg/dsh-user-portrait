{
  "name": "dsh-user-portrait",
  "version": "0.1.1",
  "description": "Learns your habits, skills and working style from everyday conversations and work summaries, keeps an evidence-backed portrait you can use as resume material, and offers a prompt hint plus tools that let the model consult it on demand.",
  "license": "MIT",
  "author": "loliisgood",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qazsedcftg/dsh-user-portrait.git"
  },
  "homepage": "https://github.com/qazsedcftg/dsh-user-portrait#readme",
  "bugs": {
    "url": "https://github.com/qazsedcftg/dsh-user-portrait/issues"
  },
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "user-portrait",
    "memory",
    "profile",
    "persona"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "check:package": "node test/package-check.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/panel-empty.png",
    "README.zh.md"
  ],
  "meta": {
    "title": "人物画像",
    "description": "从日常对话与工作总结中提炼你的习惯、技能与偏好，形成可核对的人物画像：既可作简历与自我总结的参考资料，也可按会话开启画像提示、让模型按需读取，回答更贴合你的想法。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
